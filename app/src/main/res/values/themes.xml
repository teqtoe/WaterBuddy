<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="launcher_bg">#4F46E5</color>

    <style name="Theme.WaterBuddy" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>

    <!-- அலர்ட் திரை: background இல்லாத transparent -->
    <style name="Theme.WaterBuddy.Transparent" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
